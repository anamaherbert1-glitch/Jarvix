# Secrets à configurer dans l'hébergeur, jamais dans Git.
JARVIX_PUBLIC_BASE_URL=https://votre-backend.example.com
JARVIX_ADMIN_TOKEN=REMPLACER_PAR_UN_SECRET_ALEATOIRE_LONG_DE_32_CARACTERES_MINIMUM
# Jeton(s) distinct(s) réservé(s) au chat IA Android, séparés par des virgules. Ne pas réutiliser le jeton admin.
JARVIX_DEVICE_TOKENS=REMPLACER_PAR_UN_AUTRE_SECRET_ALEATOIRE_DE_32_CARACTERES_MINIMUM
JARVIX_TOKEN_ENCRYPTION_KEY=REMPLACER_PAR_CLE_BASE64URL_DE_32_OCTETS
META_GRAPH_VERSION=v23.0

# Cerveau IA JARVIX (la clé ne doit jamais être dans l'APK ni dans Git)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Facultatif : laisser l'URL officielle par défaut si tu utilises OpenAI.
# OPENAI_BASE_URL=https://api.openai.com/v1
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
